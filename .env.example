# ============================================
# Configurações do Sistema PDV
# ============================================

# Banco de Dados
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/pdv_db

# Segurança
SECRET_KEY=sua_chave_secreta_aqui_muito_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend
URL_FRONTEND=http://localhost:3000

# Dados da Empresa
NOME_FANTASIA=Minha Empresa
CNPJ=00.000.000/0001-00

# ============================================
# Configurações NFC-e (Nota Fiscal de Consumidor Eletrônica)
# ============================================

# Habilitar/Desabilitar emissão de NFC-e (true/false)
NFCE_HABILITADO=false

# Ambiente: 1=Produção, 2=Homologação (testes)
NFCE_AMBIENTE=2

# UF do Emitente (ex: SP, RJ, MG)
NFCE_UF=MA

# Série da NFC-e
NFCE_SERIE=1

# Código IBGE do Município do Emitente (7 dígitos, sem pontos ou traços)
# Exemplos: São Paulo=3550308, Rio de Janeiro=3304557, Belo Horizonte=3106200
# São Luís-MA=2111300
# Consulte: https://www.ibge.gov.br/explica/codigos-dos-municipios.php
NFCE_MUNICIPIO_IBGE=2111300

# Caminho para o certificado digital (.pfx ou .p12)
NFCE_CERTIFICADO_CAMINHO=/caminho/para/certificado.pfx

# Senha do certificado digital
NFCE_CERTIFICADO_SENHA=senha_do_certificado

# CSC - Código de Segurança do Contribuinte
# Para homologação, use o CSC de homologação fornecido pela SEFAZ
NFCE_CSC=seu_csc_aqui

# ID do CSC
NFCE_ID_CSC=000001
